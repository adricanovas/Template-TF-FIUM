%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Configuración de código para TFG/TFM - Facultad de Informática
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\ProvidesPackage{config/listing-styles}[2026/10/07 Estilos de código TFG/TFM FIUM]

\RequirePackage{listings}
\RequirePackage{xcolor}

% Colores usados por los estilos de lenguaje
\definecolor{dkgreen}{rgb}{0,.6,0}
\definecolor{deepblue}{rgb}{0,0,0.5}
\definecolor{deepgreen}{rgb}{0,0.5,0}

% Nombres en castellano
\renewcommand{\lstlistingname}{Listado}
\renewcommand{\lstlistlistingname}{Índice de listados}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% CONFIGURACIÓN GLOBAL
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\lstset{
    frame=single,
    backgroundcolor=\color{gray!10},
    framerule=0pt,
    framextopmargin=4pt,
    framexbottommargin=4pt,
    framexleftmargin=11pt,
    framexrightmargin=0pt,
    linewidth=\linewidth,
    xleftmargin=\parindent,
    basicstyle=\small\ttfamily,
    commentstyle=\color{gray},
    keywordstyle=\bfseries,
    showstringspaces=false,
    showspaces=false,
    showtabs=false,
    columns=fullflexible,
    tabsize=4,
    numbers=left,
    numbersep=6pt,
    numberstyle=\tiny\ttfamily\color{gray!60},
    breaklines=true,
    breakatwhitespace=true,
    extendedchars=true,
    % Permite escribir tildes y eñes dentro del código
    literate={á}{{\'a}}1 {é}{{\'e}}1 {í}{{\'i}}1 {ó}{{\'o}}1 {ú}{{\'u}}1
             {Á}{{\'A}}1 {É}{{\'E}}1 {Í}{{\'I}}1 {Ó}{{\'O}}1 {Ú}{{\'U}}1
             {ñ}{{\~n}}1 {Ñ}{{\~N}}1 {ü}{{\"u}}1 {¿}{{?`}}1 {¡}{{!`}}1
}

\lstnewenvironment{listing}[1][]{
    \lstset{#1}
}{}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% ESTILOS POR LENGUAJE
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\lstdefinestyle{Consola}{
    basicstyle=\scriptsize\bfseries\ttfamily
}

\lstdefinestyle{C}{
    language=C,
    basicstyle=\scriptsize\ttfamily
}

\lstdefinestyle{C-color}{
    language=C,
    basicstyle=\scriptsize\ttfamily,
    keywordstyle=\bfseries\color{green!40!black},
    commentstyle=\itshape\color{purple!50!black},
    stringstyle=\color{orange}
}

\lstdefinestyle{C++}{
    language=C++,
    basicstyle=\scriptsize\ttfamily
}

\lstdefinestyle{C++-color}{
    language=C++,
    basicstyle=\scriptsize\ttfamily,
    keywordstyle=\bfseries\color{green!40!black},
    commentstyle=\itshape\color{purple!50!black},
    stringstyle=\color{orange}
}

\lstdefinestyle{PHP}{
    language=PHP,
    basicstyle=\scriptsize\ttfamily
}

\lstdefinestyle{Java}{
    language=Java,
    basicstyle=\scriptsize\ttfamily
}

\lstdefinestyle{Python}{
    language=Python,
    basicstyle=\scriptsize\ttfamily,
    otherkeywords={self},
    keywordstyle=\bfseries\color{deepblue},
    commentstyle=\color{dkgreen},
    stringstyle=\color{deepgreen}
}

\lstdefinestyle{Matlab}{
    language=Matlab,
    basicstyle=\scriptsize\ttfamily,
    keywordstyle=\bfseries\color{deepblue},
    commentstyle=\color{dkgreen}
}

\lstdefinestyle{R}{
    language=R,
    basicstyle=\scriptsize\ttfamily,
    keywordstyle=\bfseries
}

\lstdefinestyle{Latex}{
    language=[LaTeX]{TeX},
    basicstyle=\scriptsize\ttfamily,
    numbers=none
}

\endinput
